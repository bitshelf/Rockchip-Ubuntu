# Recommended production hardening and post-mortem diagnostics.
# These are kept separate from the functional Ubuntu baseline so that their
# boot-time, memory and module-signing implications can be qualified first.

# Ubuntu generic arm64 hardening policy
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y

# Field diagnostics without requiring a writable lower root
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
