# Apply after ubuntu-common.config, industrial-recommended.config and
# rockchip_rt.config. Keep modules separate from the non-RT graphics kernel.
CONFIG_LOCALVERSION="-rt-rk3576"
# CONFIG_LOCALVERSION_AUTO is not set
CONFIG_DRM_PANFROST=y
# CONFIG_MALI_BIFROST is not set
CONFIG_WATCHDOG_SYSFS=y
# The upstream Goodix driver supports the board's goodix,gt911 binding.
# The BSP GT9XX driver also registers as Goodix-TS, causing a duplicate
# registration when both are built in. Keep the upstream implementation.
# CONFIG_TOUCHSCREEN_GT9XX is not set
