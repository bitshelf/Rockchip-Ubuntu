# Ubuntu 24.04/26.04 common kernel baseline for Rockchip ARM64.
# Keep boot-critical filesystems built in because the immutable root and its
# userdata upper are assembled from initramfs before the real root is mounted.

# ARM64 and early boot
CONFIG_ARM64_4K_PAGES=y
# Chromium's V8 sandbox reserves a terabyte of virtual address space. A
# 39-bit kernel forces partial reservations and can fail shared ArrayBuffer
# mappings used by WebGPU readback. Keep the sandbox and use a 48-bit VA.
# CONFIG_ARM64_VA_BITS_39 is not set
CONFIG_ARM64_VA_BITS_48=y
CONFIG_SMP=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_RD_XZ=y
CONFIG_RD_ZSTD=y

# Immutable EROFS lower root, ext4 userdata upper, initramfs and snap images
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
# CONFIG_EROFS_FS_ZIP is not set
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_OVERLAY_FS=y
# CONFIG_OVERLAY_FS_REDIRECT_DIR is not set
# CONFIG_OVERLAY_FS_INDEX is not set
CONFIG_OVERLAY_FS_XINO_AUTO=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_ZLIB=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_ZSTD=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_FHANDLE=y
CONFIG_AUTOFS_FS=y
CONFIG_CONFIGFS_FS=y
CONFIG_OF_OVERLAY=y
CONFIG_EFI_PARTITION=y

# systemd and cgroup v2
CONFIG_CGROUPS=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CPUSETS=y
CONFIG_MEMCG=y
CONFIG_PSI=y

# Namespace, seccomp and BPF isolation used by systemd, containers and snapd
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y

# Userspace event and mount APIs
CONFIG_INOTIFY_USER=y
CONFIG_FANOTIFY=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y

# Ubuntu security model and strict snap confinement
CONFIG_AUDIT=y
CONFIG_AUDITSYSCALL=y
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_INTROSPECT_POLICY=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_SECURITY_APPARMOR_EXPORT_BINARY=y
CONFIG_SECURITY_APPARMOR_PARANOID_LOAD=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,integrity,apparmor,bpf"
CONFIG_KEYS=y
# snapd mount namespaces and systemd RestrictFileSystems= (bpf-restrict-fs)
# require the BPF LSM to be actually enabled (the "bpf" entry in CONFIG_LSM
# is inert without it).  systemd's BPF object additionally needs vmlinux
# BTF; the base defconfig's reduced DWARF is mutually exclusive with
# DEBUG_INFO_BTF, so both options are pinned together here.
CONFIG_BPF_LSM=y
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_BTF=y
# CONFIG_DEBUG_INFO_REDUCED is not set

# NetworkManager, systemd-resolved, VPN and container networking
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_IPV6=y
CONFIG_NETFILTER=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_VETH=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
CONFIG_VXLAN=y
CONFIG_TUN=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y

# USB ADB gadget: DWC3 dual-role controller + ConfigFS + FunctionFS
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ROLE_SWITCH=y
CONFIG_USB_GADGET=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_F_FS=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y

# Hardware clock used before network time is available
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y
# Board ethernet contract: both RK3576 GMACs use RTL8211F PHYs.
# These options are NOT in the SDK's tracked defconfig (only in a transient
# .config); without them a fresh kernel build drops the Realtek PHY driver
# and the GMAC probe fails, removing the ethernet nodes from the image.
CONFIG_STMMAC_ETH=y
CONFIG_REALTEK_PHY=y
CONFIG_MOTORCOMM_PHY=y
CONFIG_ROCKCHIP_PHY=y
CONFIG_RK630_PHY=y
