# JR3576 Server qualification: use the vendor Mali userspace selected by
# build-overlay-root.sh's default GPU_STACK=libmali.
CONFIG_MALI_BIFROST=y
# CONFIG_DRM_PANFROST is not set

# Selected platform modules and read-only diagnostics used in board QA.
CONFIG_USB_SERIAL_CH341=m
CONFIG_PSTORE=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_WATCHDOG=y
CONFIG_DW_WATCHDOG=y
# cgroup v2 does not provide RT group budgets; RKAIQ needs realtime stats threads.
# CONFIG_RT_GROUP_SCHED is not set
