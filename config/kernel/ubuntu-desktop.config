# Additional Ubuntu Desktop baseline for the RK3576 Wayland session.
# RK3576 display, camera and audio drivers remain in the vendor board fragment;
# this file records the generic userspace interfaces expected by Ubuntu.

# DRM/KMS and local console
CONFIG_DRM=y
CONFIG_DRM_ROCKCHIP=y
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_DMA_SHARED_BUFFER=y
CONFIG_SYNC_FILE=y
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# Keyboard, pointer, touchscreen and USB HID
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_GENERIC=y
CONFIG_USB_HID=y
CONFIG_UHID=y

# Camera, hardware video and audio frameworks
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L_PLATFORM_DRIVERS=y
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_SOC=y

# Removable storage and desktop radio management
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_STORAGE=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_RFKILL=y
CONFIG_BT=y
