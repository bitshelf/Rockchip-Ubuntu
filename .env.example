# Console firstboot creates the customer account; no preset credentials.
ENABLE_CONSOLE_FIRSTBOOT="${ENABLE_CONSOLE_FIRSTBOOT:-yes}"
FIRSTBOOT_PROFILE="${FIRSTBOOT_PROFILE:-server}"

# The setup script creates this dedicated Forgejo host-runner account.
CI_USER="${CI_USER:-ubuntu-ci}"

# On an OverlayFS host, set this to a real backing filesystem. The script
# bind-mounts it at the standard /var/lib/docker and /var/lib/containerd paths.
BUILD_STORAGE_ROOT="${BUILD_STORAGE_ROOT:-}"

# x86 defaults to <repository>/build. ARM64 defaults to
# /var/lib/ubuntu-ci/build so native builds and Forgejo CI share one path.
BUILD_OUTPUT_DIR="${BUILD_OUTPUT_DIR:-}"

# Rockchip SDK output copied into the Ubuntu build input interface. SDK_DIR
# defaults to the parent of this repository. PLATFORM_ASSET_DIR defaults to
# <BUILD_OUTPUT_DIR>/platform-assets/<SOC_MODEL>.
SDK_DIR="${SDK_DIR:-}"
SDK_OUTPUT_DIR="${SDK_OUTPUT_DIR:-}"
SDK_KERNEL_CONFIG="${SDK_KERNEL_CONFIG:-}"
SOC_MODEL="${SOC_MODEL:-}"
PLATFORM_ASSET_DIR="${PLATFORM_ASSET_DIR:-}"
PLATFORM_ASSET_BUNDLE_URL="${PLATFORM_ASSET_BUNDLE_URL:-}"
PLATFORM_ASSET_BUNDLE_SHA256="${PLATFORM_ASSET_BUNDLE_SHA256:-}"
# Optional complete HTTP Authorization header for private release assets.
PLATFORM_ASSET_AUTH_HEADER="${PLATFORM_ASSET_AUTH_HEADER:-}"
KERNEL_MODULE_CONFIG="${KERNEL_MODULE_CONFIG:-}"
KERNEL_CONFIG_REQUIREMENTS="${KERNEL_CONFIG_REQUIREMENTS:-}"
LOCAL_DEB_CONFIG="${LOCAL_DEB_CONFIG:-}"
LOCAL_DEB_BUILD_CONFIG="${LOCAL_DEB_BUILD_CONFIG:-}"
LOCAL_DEB_PREPARE_CONFIG="${LOCAL_DEB_PREPARE_CONFIG:-}"
LOCAL_DEB_INSTALL_CONFIG="${LOCAL_DEB_INSTALL_CONFIG:-}"

# Independent ext4 bootfs. Board policy supplies size, label and base DTB;
# BOOTFS_INITRD is optional until the initramfs feature is integrated.
BOOTFS_CONFIG="${BOOTFS_CONFIG:-}"
BOOTFS_TEMPLATE="${BOOTFS_TEMPLATE:-}"
BOOTFS_OUTPUT="${BOOTFS_OUTPUT:-}"
BOOTFS_INITRD="${BOOTFS_INITRD:-}"
BOOTFS_BASE_DTB="${BOOTFS_BASE_DTB:-}"
# Every .dtso/.dtbo directly below this directory is installed and enabled.
# It may point to a repository directory or a customer directory below build/.
DTS_OVERLAY_DIR="${DTS_OVERLAY_DIR:-}"

# EROFS lower and persistent ext4 OverlayFS backing image. Empty paths are
# derived from the Server rootfs artifact and BUILD_OUTPUT_DIR.
ROOTFS_TARBALL="${ROOTFS_TARBALL:-}"
EROFS_ROOTFS_IMAGE="${EROFS_ROOTFS_IMAGE:-}"
USERDATA_IMAGE="${USERDATA_IMAGE:-}"
USERDATA_SIZE_MB="${USERDATA_SIZE_MB:-64}"
# Rockchip recovery updateEngine is staged from the SDK source Git checkout,
# built as an ARM64 Debian package and installed during EROFS assembly.
UPDATE_ENGINE_SOURCE_DIR="${UPDATE_ENGINE_SOURCE_DIR:-}"
UPDATE_ENGINE_SOURCE_ARCHIVE="${UPDATE_ENGINE_SOURCE_ARCHIVE:-}"
UPDATE_ENGINE_PACKAGE_DIR="${UPDATE_ENGINE_PACKAGE_DIR:-}"
UPDATE_ENGINE_DEB="${UPDATE_ENGINE_DEB:-}"


# ARM64 cross-build container for x86_64 hosts. Select the target Ubuntu
# userland explicitly; keep release choice outside the reusable implementation.
CROSS_BASE_IMAGE="${CROSS_BASE_IMAGE:-ubuntu}"
CROSS_BASE_TAG="${CROSS_BASE_TAG:-}"
CROSS_ENV_IMAGE="${CROSS_ENV_IMAGE:-}"
CROSS_OUTPUT_DIR="${CROSS_OUTPUT_DIR:-}"
NATIVE_APT_MIRROR="${NATIVE_APT_MIRROR:-https://mirrors.tuna.tsinghua.edu.cn/ubuntu/}"
TARGET_APT_MIRROR="${TARGET_APT_MIRROR:-https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports/}"
CROSS_BUILD_JOBS="${CROSS_BUILD_JOBS:-}"


# Empty means: prefer TUNA, then Alibaba Cloud, then Tencent Cloud. An explicit
# Debian/Ubuntu mirror URL can be supplied for a controlled build network.
APT_MIRROR="${APT_MIRROR:-}"

FORGEJO_PUBLIC_HOST="${FORGEJO_PUBLIC_HOST:-}"
FORGEJO_VERSION="${FORGEJO_VERSION:-15}"
RUNNER_VERSION="${RUNNER_VERSION:-12.7.3}"
FORGEJO_ADMIN_USER="${FORGEJO_ADMIN_USER:-ubuntu}"
FORGEJO_ADMIN_EMAIL="${FORGEJO_ADMIN_EMAIL:-ubuntu@localhost}"

# apt-cacher-ng listens locally on this address after setup.
APT_PROXY="${APT_PROXY:-http://127.0.0.1:3142}"

UBUNTU_PORTS_MIRROR="${UBUNTU_PORTS_MIRROR:-https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports/}"

# Optional upstream network proxy. Do not put credentials in tracked files.
HTTP_PROXY="${HTTP_PROXY:-}"
HTTPS_PROXY="${HTTPS_PROXY:-${HTTP_PROXY}}"
NO_PROXY="${NO_PROXY:-127.0.0.1,localhost,::1}"
