 cmd/pxe.c                         | 104 +++++++++++++++++++++++++++++++++++++++
 doc/README.pxe                    |   9 ++++
 include/config_distro_bootcmd.h   |   3 +-
 include/configs/evb_rk3576.h      |   5 +-
 include/configs/rk3576_common.h   |   2 +-
 include/configs/rockchip-common.h |  13 +++--
 7 files changed, 134 insertions(+), 14 deletions(-)

diff --git a/arch/arm/mach-rockchip/board.c b/arch/arm/mach-rockchip/board.c
index 6b63d52..bc38e75 100644
--- a/arch/arm/mach-rockchip/board.c
+++ b/arch/arm/mach-rockchip/board.c
@@ -1460,7 +1460,16 @@ static void bootargs_add_dtb_dtbo(void *fdt, bool verbose)
 #ifdef CONFIG_ANDROID_AB
 		env_update_filter("bootargs", bootargs, "root=");
 #else
-		env_update("bootargs", bootargs);
+		/*
+		 * A distro/extlinux APPEND line is the explicit boot policy.
+		 * Keep its root= argument instead of replacing it with the
+		 * vendor DTB's image-specific root= value.
+		 */
+		if (env_get("bootargs") &&
+		    strstr(env_get("bootargs"), "root="))
+			env_update_filter("bootargs", bootargs, "root=");
+		else
+			env_update("bootargs", bootargs);
 #endif
 	}
 }
@@ -1614,4 +1623,3 @@ int ft_verify_fdt(void *fdt)
 #endif
 	return 1;
 }
-
