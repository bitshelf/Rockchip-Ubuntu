+
+// Linux ARM Mesa needs GLVND and the multiarch DRI/GBM modules after
+// --gpu-sandbox-start-early. Keep library access specific and read-only.
+void AddArmMesaGpuPermissions(std::vector<BrokerFilePermission>* permissions) {
+  static const char* const kLibraries[] = {
+      "/proc/cpuinfo",
+      "/usr/lib/aarch64-linux-gnu/libvulkan_panfrost_experimental.so",
+      "/usr/lib/aarch64-linux-gnu/libEGL.so.1",
+      "/usr/lib/aarch64-linux-gnu/libEGL_mesa.so.0",
+      "/usr/lib/aarch64-linux-gnu/libGLESv2.so.2",
+      "/usr/lib/aarch64-linux-gnu/libGLdispatch.so.0",
+      "/usr/lib/aarch64-linux-gnu/libgbm.so.1",
+      "/usr/lib/aarch64-linux-gnu/gbm/dri_gbm.so",
+      "/usr/lib/aarch64-linux-gnu/dri/panfrost_dri.so",
+      "/usr/lib/aarch64-linux-gnu/dri/libdril_dri.so",
+      "/usr/share/glvnd/egl_vendor.d",
+      "/usr/share/glvnd/egl_vendor.d/50_mesa.json"};
+  for (const char* library : kLibraries)
+    permissions->push_back(BrokerFilePermission::ReadOnly(library));
+  // Mesa versions the Gallium filename. Discover only this library family,
+  // rather than permitting the entire multiarch library directory.
+  base::FileEnumerator libraries(
+      base::FilePath("/usr/lib/aarch64-linux-gnu"), false,
+      base::FileEnumerator::FILES, FILE_PATH_LITERAL("libgallium-*.so"));
+  for (base::FilePath library = libraries.Next(); !library.empty();
+       library = libraries.Next()) {
+    permissions->push_back(BrokerFilePermission::ReadOnly(library.value()));
+  }
 }
 
