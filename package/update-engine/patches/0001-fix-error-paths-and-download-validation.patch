From: Ubuntu Embedded Team <ljzyx86@qq.com>
Subject: [PATCH] update_engine: fix error paths and validate downloads

Keep the Rockchip update flow unchanged while removing undefined behaviour
reported by current Ubuntu compilers. Also reject failed output-file creation
and HTTP error responses instead of continuing with an invalid image.

--- a/mtdutils/mtdutils.c
+++ b/mtdutils/mtdutils.c
@@ -289,8 +289,8 @@ MtdReadContext *mtd_read_partition(const MtdPartition *partition)
     //sprintf(mtddevname, "/dev/mtd/mtd%d", partition->device_index);
     ctx->fd = open(mtddevname, O_RDONLY);
     if (ctx->fd < 0) {
-        free(ctx);
         free(ctx->buffer);
+        free(ctx);
         return NULL;
     }
 
--- a/update_engine/download.c
+++ b/update_engine/download.c
@@ -34,9 +34,12 @@ int my_progress_func(char *progress_data,
                      double ultotal,
                      double ulnow)
 {
-    processvalue = ulnow / ultotal * 100 / 110;
+    if (ultotal > 0)
+        processvalue = ulnow / ultotal * 100 / 110;
+    else
+        processvalue = 0;
     //LOGI("ultotal is %f, ulnow is %f, t is %f, d is %f\n", ultotal, ulnow, t, d);
-    if (down_processvalue != (int)(d / t * 100)) {
+    if (t > 0 && down_processvalue != (int)(d / t * 100)) {
         down_processvalue = (int)(d / t * 100);
         LOGI("down_processvalue is %d%\n", down_processvalue);
     }
@@ -51,7 +54,7 @@ int download_file(char *url, char const *output_filename)
         return -2;
     }
     CURL *curl;
-    CURLcode res;
+    CURLcode res = CURLE_FAILED_INIT;
     FILE *outfile;
     char const *progress_data = "* ";
     down_processvalue = -1;
@@ -59,10 +62,18 @@ int download_file(char *url, char const *output_filename)
     curl = curl_easy_init();
     if (curl) {
         outfile = fopen(output_filename, "wb");
+        if (outfile == NULL) {
+            LOGE("open %s failed\n", output_filename);
+            curl_easy_cleanup(curl);
+            return -1;
+        }
 
         curl_easy_setopt(curl, CURLOPT_URL, url);
         curl_easy_setopt(curl, CURLOPT_WRITEDATA, outfile);
         curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, my_write_func);
+        curl_easy_setopt(curl, CURLOPT_FAILONERROR, 1L);
+        curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
+        curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
         curl_easy_setopt(curl, CURLOPT_NOPROGRESS, false);
         curl_easy_setopt(curl, CURLOPT_PROGRESSFUNCTION, my_progress_func);
         curl_easy_setopt(curl, CURLOPT_PROGRESSDATA, progress_data);
--- a/update_engine/do_patch.c
+++ b/update_engine/do_patch.c
@@ -97,7 +97,7 @@ long do_patch_rkimg(const char *img, long offset, long size,
     FILE * f = NULL, * cpf = NULL, * dpf = NULL, * epf = NULL;
     BZFILE * cpfbz2, * dpfbz2, * epfbz2;
     int cbz2err, dbz2err, ebz2err;
-    int fd;
+    int fd = -1;
     ssize_t bzctrllen, bzdatalen;
     unsigned char header[32], buf[8];
     unsigned char *old  = NULL, *new_ptr = NULL;
@@ -120,7 +120,7 @@ long do_patch_rkimg(const char *img, long offset, long size,
     len = 0;
     while (len != TAIL_SIZE) {
         ret = read(fd_img, tail + len, TAIL_SIZE - len);
-        if (ret < 0) {
+        if (ret <= 0) {
             LOGE("read %s tail err\n", img);
             close(fd_img);
             return -1;
@@ -135,19 +135,6 @@ long do_patch_rkimg(const char *img, long offset, long size,
         if (token[j] == NULL)
             break;
     }
-    name = token[TID_NAME];
-    md5sum = token[TID_MD5SUM];
-
-    /* When unexpected reboot during patching/writing happened,
-     * if dst_file is in correct state, then old image may already broken
-     */
-    if (stat(dst_file, &dst_stat) == 0 &&
-        compareMd5sum(dst_file, (unsigned char *)md5sum, 0, dst_stat.st_size)) {
-        LOGI("Recovery from unecptected reboot successfully.");
-        return dst_stat.st_size;
-    }
-    /* If dst_file exist but md5sum is wrong, old image file is clean, hopefully */
-
     //check tail magic, return 0 if not exist
     if (j == 0 || strncmp(MAGIC_TAIL, token[TID_HEAD], strlen(MAGIC_TAIL)) != 0) {
         LOGW("Not a diff image, ret = %ld\n", ret);
@@ -165,6 +152,18 @@ long do_patch_rkimg(const char *img, long offset, long size,
         LOGE("Bad Tail header of bsdiff patch\n");
         return -1;
     }
+    name = token[TID_NAME];
+    md5sum = token[TID_MD5SUM];
+
+    /* When unexpected reboot during patching/writing happened,
+     * if dst_file is in correct state, then old image may already broken
+     */
+    if (stat(dst_file, &dst_stat) == 0 &&
+        compareMd5sum(dst_file, (unsigned char *)md5sum, 0, dst_stat.st_size)) {
+        LOGI("Recovery from unecptected reboot successfully.");
+        return dst_stat.st_size;
+    }
+    /* If dst_file exists but md5sum is wrong, the old image is still clean. */
 
     //TODO: check dst_file dir size, return -1 if space too small.
 
--- a/mtdutils/mtdutils.c
+++ b/mtdutils/mtdutils.c
@@ -322,20 +322,20 @@ static int read_block(const MtdPartition *partition, int fd, char *data)
     while (pos + size <= (int) partition->size) {
         if (lseek64(fd, pos, SEEK_SET) != pos || read(fd, data, size) != size) {
             fprintf(stderr, "mtd: read error at 0x%08llx (%s)\n",
-                    pos, strerror(errno));
+                    (unsigned long long)pos, strerror(errno));
         } else if (ioctl(fd, ECCGETSTATS, &after)) {
             fprintf(stderr, "mtd: ECCGETSTATS error (%s)\n", strerror(errno));
             return -1;
         } else if (after.failed != before.failed) {
             fprintf(stderr, "mtd: ECC errors (%d soft, %d hard) at 0x%08llx\n",
                     after.corrected - before.corrected,
-                    after.failed - before.failed, pos);
+                    after.failed - before.failed, (unsigned long long)pos);
             // copy the comparison baseline for the next read.
             memcpy(&before, &after, sizeof(struct mtd_ecc_stats));
         } else if ((mgbb = ioctl(fd, MEMGETBADBLOCK, &pos))) {
             fprintf(stderr,
                     "mtd: MEMGETBADBLOCK returned %d at 0x%08llx (errno=%d)\n",
-                    mgbb, pos, errno);
+                    mgbb, (unsigned long long)pos, errno);
         } else {
             return 0;  // Success!
         }
@@ -480,7 +480,8 @@ static int write_block(const MtdPartition *partition, int fd, const char *data)
             if (retry > 0) {
                 fprintf(stderr, "mtd: wrote block after %d retries\n", retry);
             }
-            fprintf(stderr, "mtd: successfully wrote block at %llx\n", pos);
+            fprintf(stderr, "mtd: successfully wrote block at %llx\n",
+                    (unsigned long long)pos);
             return 0;  // Success!
         }
 
