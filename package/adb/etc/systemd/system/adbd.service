[Unit]
Description=Android Debug Bridge USB gadget
Documentation=file:/usr/share/doc/adbd/README.adbd
DefaultDependencies=no
Requires=adbd-gadget.service
After=adbd-gadget.service

[Service]
Type=notify
# Keep the daemon in the initial namespaces and as root. In particular, do
# not use PrivateNetwork, a capability allowlist or a system-call allowlist:
# adb shell must observe the same interfaces and permit the same diagnostics
# as the serial root console.
ExecStart=/usr/lib/android-sdk/platform-tools/adbd
ExecStartPost=/usr/libexec/rk-adbd-gadget activate
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=sysinit.target
