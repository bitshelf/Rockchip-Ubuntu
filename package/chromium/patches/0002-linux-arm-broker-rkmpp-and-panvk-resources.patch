+
+// RKMPP uses a userspace libv4l2 plugin and the MPP/DMA-heap devices rather
+// than kernel V4L2 decoder ioctls. Keep these additions limited to ARM builds
+// with accelerated V4L2 enabled; never grant recursive access to /dev.
+void AddRockchipV4L2Permissions(std::vector<BrokerFilePermission>* permissions) {
+  permissions->push_back(BrokerFilePermission::ReadWrite("/dev/mpp_service"));
+  permissions->push_back(BrokerFilePermission::ReadOnly("/dev/dma_heap"));
+  static const char* const kHeaps[] = {
+      "system", "system-uncached", "system-dma32", "system-uncached-dma32",
+      "cma", "cma-uncached", "cma-dma32", "cma-uncached-dma32"};
+  for (const char* heap : kHeaps) {
+    permissions->push_back(BrokerFilePermission::ReadOnly(
+        std::string("/dev/dma_heap/") + heap));
+  }
+  permissions->push_back(BrokerFilePermission::ReadOnlyRecursive(
+      "/proc/device-tree/"));
+  static const char* const kPluginPaths[] = {
+      "/usr/lib/aarch64-linux-gnu/libv4l/plugins",
+      "/usr/lib/aarch64-linux-gnu/libv4l/plugins/libv4l-rkmpp.so"};
+  for (const char* path : kPluginPaths)
+    permissions->push_back(BrokerFilePermission::ReadOnly(path));
 }
 
