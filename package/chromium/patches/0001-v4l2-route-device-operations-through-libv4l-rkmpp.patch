+// libv4l-rkmpp owns plugin state and supplies an epoll-backed descriptor.
+// Keep the library loaded for process lifetime so mmap/munmap and close use
+// the same ABI. No LD_PRELOAD interposition of unrelated browser I/O.
+struct RkLibV4L2 {
+  RkLibV4L2() {
+    void* handle = dlopen("libv4l2.so.0", RTLD_NOW | RTLD_LOCAL);
+    if (!handle) return;
+    fd_open = reinterpret_cast<decltype(fd_open)>(dlsym(handle, "v4l2_fd_open"));
+    ioctl = reinterpret_cast<decltype(ioctl)>(dlsym(handle, "v4l2_ioctl"));
+    close = reinterpret_cast<decltype(close)>(dlsym(handle, "v4l2_close"));
+    mmap = reinterpret_cast<decltype(mmap)>(dlsym(handle, "v4l2_mmap"));
+    munmap = reinterpret_cast<decltype(munmap)>(dlsym(handle, "v4l2_munmap"));
+  }
+  bool ready() const { return fd_open && ioctl && close && mmap && munmap; }
+  int (*fd_open)(int, int) = nullptr;
+  int (*ioctl)(int, unsigned long, ...) = nullptr;
+  int (*close)(int) = nullptr;
+  void* (*mmap)(void*, size_t, int, int, int, int64_t) = nullptr;
+  int (*munmap)(void*, size_t) = nullptr;
+};
+
+RkLibV4L2& RkV4L2() {
+  static RkLibV4L2 library;
+  return library;
+}
 
