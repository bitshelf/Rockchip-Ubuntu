target_os = "linux"
target_cpu = "arm64"
is_debug = false
is_official_build = false
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
treat_warnings_as_errors = false
use_sysroot = true
is_cfi = false
chrome_pgo_phase = 0
ozone_auto_platforms = false
ozone_platform_wayland = true
ozone_platform_x11 = true
